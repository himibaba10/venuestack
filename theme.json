{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"customTemplates": [
		{
			"name": "single-venue_space",
			"postTypes": [
				"venue_space"
			],
			"title": "Single Space"
		}
	],
	"settings": {
		"appearanceTools": true,
		"border": {
			"radiusSizes": [
				{
					"name": "None",
					"size": "0",
					"slug": "none"
				}
			]
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"gradients": [
				{
					"gradient": "linear-gradient(135deg, #2F3B34 0%, #211D1B 100%)",
					"name": "Dusk",
					"slug": "dusk"
				},
				{
					"gradient": "linear-gradient(90deg, #A6763D 0%, #C9A06B 50%, #A6763D 100%)",
					"name": "Brass Sheen",
					"slug": "brass-sheen"
				}
			],
			"palette": [
				{
					"color": "#211D1B",
					"name": "Ink",
					"slug": "ink"
				},
				{
					"color": "#F2ECE3",
					"name": "Plaster",
					"slug": "plaster"
				},
				{
					"color": "#F8F4ED",
					"name": "Card",
					"slug": "card"
				},
				{
					"color": "#E4DACB",
					"name": "Stone",
					"slug": "stone"
				},
				{
					"color": "#A6763D",
					"name": "Brass",
					"slug": "brass"
				},
				{
					"color": "#2F3B34",
					"name": "Evergreen",
					"slug": "evergreen"
				},
				{
					"color": "#B4552F",
					"name": "Ember",
					"slug": "ember"
				},
				{
					"color": "#857F78",
					"name": "Muted",
					"slug": "muted"
				},
				{
					"color": "#D4CFC8",
					"name": "Plaster muted",
					"slug": "plaster-muted"
				},
				{
					"color": "#D5CFC7",
					"name": "Rule",
					"slug": "rule"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "2X-Small",
					"size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)",
					"slug": "20"
				},
				{
					"name": "X-Small",
					"size": "clamp(1rem, 0.8rem + 0.8vw, 1.5rem)",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "clamp(1.5rem, 1.1rem + 1.4vw, 2.5rem)",
					"slug": "40"
				},
				{
					"name": "Medium",
					"size": "clamp(2.25rem, 1.6rem + 2.4vw, 4rem)",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "clamp(3.5rem, 2.4rem + 4vw, 6.5rem)",
					"slug": "60"
				},
				{
					"name": "X-Large",
					"size": "clamp(5rem, 3.2rem + 6vw, 9rem)",
					"slug": "70"
				},
				{
					"name": "2X-Large",
					"size": "clamp(6.5rem, 4rem + 8.5vw, 12rem)",
					"slug": "80"
				}
			],
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontDisplay": "swap",
							"fontFamily": "Work Sans",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/work-sans/work-sans-latin-wght-normal.woff2"
							]
						},
						{
							"fontDisplay": "swap",
							"fontFamily": "Work Sans",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/work-sans/work-sans-latin-ext-wght-normal.woff2"
							]
						}
					],
					"fontFamily": "\"Work Sans\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"name": "Work Sans",
					"slug": "work-sans"
				},
				{
					"fontFace": [
						{
							"fontDisplay": "swap",
							"fontFamily": "Playfair Display",
							"fontStyle": "normal",
							"fontWeight": "400 900",
							"src": [
								"file:./assets/fonts/playfair-display/playfair-display-latin-wght-normal.woff2"
							]
						},
						{
							"fontDisplay": "swap",
							"fontFamily": "Playfair Display",
							"fontStyle": "normal",
							"fontWeight": "400 900",
							"src": [
								"file:./assets/fonts/playfair-display/playfair-display-latin-ext-wght-normal.woff2"
							]
						}
					],
					"fontFamily": "\"Playfair Display\", \"Times New Roman\", Georgia, serif",
					"name": "Playfair Display",
					"slug": "playfair-display"
				}
			],
			"fontSizes": [
				{
					"fluid": {
						"max": "0.875rem",
						"min": "0.8125rem"
					},
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"fluid": {
						"max": "1.125rem",
						"min": "1rem"
					},
					"name": "Medium",
					"size": "1.0625rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"max": "1.5rem",
						"min": "1.1875rem"
					},
					"name": "Large",
					"size": "1.375rem",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "2.375rem",
						"min": "1.625rem"
					},
					"name": "Extra Large",
					"size": "2rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"max": "3.75rem",
						"min": "2.25rem"
					},
					"name": "2X Large",
					"size": "3rem",
					"slug": "xx-large"
				},
				{
					"fluid": {
						"max": "5.5rem",
						"min": "2.75rem"
					},
					"name": "3X Large",
					"size": "4.5rem",
					"slug": "xxx-large"
				}
			]
		},
		"useRootPaddingAwareAlignments": true,
		"viewport": {
			"mobile": "480px",
			"tablet": "782px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--plaster)",
			"text": "var(--wp--preset--color--ink)"
		},
		"elements": {
			"button": {
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--evergreen)",
						"text": "var(--wp--preset--color--plaster)"
					}
				},
				"border": {
					"radius": "0"
				},
				"color": {
					"background": "var(--wp--preset--color--brass)",
					"text": "var(--wp--preset--color--plaster)"
				},
				"spacing": {
					"padding": {
						"bottom": "0.875rem",
						"left": "1.75rem",
						"right": "1.75rem",
						"top": "0.875rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--work-sans)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "500",
					"letterSpacing": "0"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--evergreen)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--work-sans)",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)",
					"fontWeight": "700",
					"letterSpacing": "-0.025em",
					"lineHeight": "1.05"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "600",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.1"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "600",
					"letterSpacing": "-0.015em"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"letterSpacing": "-0.01em"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--work-sans)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "500",
					"letterSpacing": "0",
					"lineHeight": "1.4"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--work-sans)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500",
					"letterSpacing": "0",
					"lineHeight": "1.4"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--playfair-display)",
					"fontWeight": "600",
					"lineHeight": "1.15"
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--ember)"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			}
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"bottom": "0",
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)",
				"top": "0"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--work-sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.65"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	]
}