{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "primary",
					"name": "Primary",
					"color": "#2C3E50"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#D4AF37"
				},
				{
					"slug": "background",
					"name": "Background",
					"color": "#FDFDFD"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#F4F5F7"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#1A252F"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#5D6D7E"
				},
				{
					"slug": "base",
					"name": "Base",
					"color": "#FDFDFD"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "20",
					"name": "2X-Small",
					"size": "clamp(0.5rem, 0.45rem + 0.25vw, 0.625rem)"
				},
				{
					"slug": "30",
					"name": "X-Small",
					"size": "clamp(0.75rem, 0.65rem + 0.4vw, 1rem)"
				},
				{
					"slug": "40",
					"name": "Small",
					"size": "clamp(1rem, 0.85rem + 0.6vw, 1.5rem)"
				},
				{
					"slug": "50",
					"name": "Medium",
					"size": "clamp(1.5rem, 1.15rem + 1.1vw, 2.5rem)"
				},
				{
					"slug": "60",
					"name": "Large",
					"size": "clamp(2rem, 1.4rem + 1.8vw, 3.5rem)"
				},
				{
					"slug": "70",
					"name": "X-Large",
					"size": "clamp(3rem, 1.9rem + 3vw, 5rem)"
				},
				{
					"slug": "80",
					"name": "2X-Large",
					"size": "clamp(4rem, 2.4rem + 4.5vw, 8rem)"
				}
			],
			"units": [ "%", "px", "em", "rem", "vh", "vw" ]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": {
						"min": "0.8125rem",
						"max": "0.875rem"
					}
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.375rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra Large",
					"size": "1.75rem",
					"fluid": {
						"min": "1.5rem",
						"max": "2.125rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "2X Large",
					"size": "2.5rem",
					"fluid": {
						"min": "2rem",
						"max": "3.25rem"
					}
				},
				{
					"slug": "xxx-large",
					"name": "3X Large",
					"size": "3.5rem",
					"fluid": {
						"min": "2.5rem",
						"max": "4.5rem"
					}
				}
			],
			"fontFamilies": [
				{
					"name": "Inter",
					"slug": "inter",
					"fontFamily": "\"Inter\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter/inter-latin-wght-normal.woff2" ]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter/inter-latin-ext-wght-normal.woff2" ]
						}
					]
				},
				{
					"name": "Playfair Display",
					"slug": "playfair-display",
					"fontFamily": "\"Playfair Display\", \"Times New Roman\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Playfair Display",
							"fontWeight": "400 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/playfair-display/playfair-display-latin-wght-normal.woff2" ]
						},
						{
							"fontFamily": "Playfair Display",
							"fontWeight": "400 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/playfair-display/playfair-display-latin-ext-wght-normal.woff2" ]
						}
					]
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|background",
			"text": "var:preset|color|primary"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|40",
			"padding": {
				"top": "0",
				"right": "var:preset|spacing|40",
				"bottom": "0",
				"left": "var:preset|spacing|40"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|inter",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|playfair-display",
					"fontWeight": "600",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var:preset|color|primary"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xxx-large",
					"fontWeight": "700",
					"lineHeight": "1.1"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"fontWeight": "600"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "600"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "600"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var:preset|font-family|inter",
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600",
					"letterSpacing": "0.02em",
					"textTransform": "uppercase"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var:preset|font-family|inter",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600",
					"letterSpacing": "0.04em",
					"textTransform": "uppercase"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|accent"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|background"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|inter",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600",
					"letterSpacing": "0.02em",
					"textTransform": "uppercase"
				},
				"border": {
					"radius": "2px"
				},
				"spacing": {
					"padding": {
						"top": "0.875rem",
						"right": "1.75rem",
						"bottom": "0.875rem",
						"left": "1.75rem"
					}
				},
				":hover": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|background"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|inter",
					"fontSize": "var:preset|font-size|small"
				}
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	]
}
